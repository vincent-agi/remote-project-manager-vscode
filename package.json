{
  "name": "remote-project-manager",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.0.1",
  "publisher": "local-dev",
  "icon": "media/plugin-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/vincent-agi/vs-code-github-internal-project-managment.git"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "remoteProjectManager.openPanel",
        "title": "%command.openPanel.title%"
      },
      {
        "command": "remoteProjectManager.signOutGitLab",
        "title": "%command.signOutGitLab.title%"
      },
      {
        "command": "remoteProjectManager.newIssue",
        "title": "%command.newIssue.title%"
      },
      {
        "command": "remoteProjectManager.newMilestone",
        "title": "%command.newMilestone.title%"
      },
      {
        "command": "remoteProjectManager.refresh",
        "title": "%command.refresh.title%"
      },
      {
        "command": "remoteProjectManager.composeCommit",
        "title": "%command.composeCommit.title%",
        "icon": "$(sparkle)"
      },
      {
        "command": "remoteProjectManager.pickGitmoji",
        "title": "%command.pickGitmoji.title%"
      },
      {
        "command": "remoteProjectManager.copyIssueContext",
        "title": "%command.copyIssueContext.title%",
        "icon": "$(copy)"
      },
      {
        "command": "remoteProjectManager.createPrFromIssue",
        "title": "%command.createPrFromIssue.title%",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "remoteProjectManager.showGitGraph",
        "title": "%command.showGitGraph.title%"
      },
      {
        "command": "remoteProjectManager.lintCommitHistory",
        "title": "%command.lintCommitHistory.title%"
      },
      {
        "command": "remoteProjectManager.exportMilestoneContext",
        "title": "%command.exportMilestoneContext.title%"
      },
      {
        "command": "remoteProjectManager.createBranchForIssue",
        "title": "%command.createBranchForIssue.title%",
        "icon": "$(git-branch)"
      },
      {
        "command": "remoteProjectManager.openIssueInBrowser",
        "title": "%command.openIssueInBrowser.title%",
        "icon": "$(link-external)"
      },
      {
        "command": "remoteProjectManager.runDiagnostics",
        "title": "%command.runDiagnostics.title%"
      },
      {
        "command": "remoteProjectManager.installCommitMsgHook",
        "title": "%command.installCommitMsgHook.title%"
      },
      {
        "command": "remoteProjectManager.uninstallCommitMsgHook",
        "title": "%command.uninstallCommitMsgHook.title%"
      },
      {
        "command": "remoteProjectManager.createIssueFromSelection",
        "title": "%command.createIssueFromSelection.title%"
      },
      {
        "command": "remoteProjectManager.createIssueFromTodo",
        "title": "%command.createIssueFromTodo.title%"
      },
      {
        "command": "remoteProjectManager.openIssueByNumber",
        "title": "%command.openIssueByNumber.title%"
      },
      {
        "command": "remoteProjectManager.openWalkthrough",
        "title": "%command.openWalkthrough.title%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "remoteProjectManager",
          "title": "%viewsContainer.remoteProjectManager.title%",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "remoteProjectManager": [
        {
          "id": "remoteProjectManager.sidebar",
          "name": "%view.sidebar.name%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "remoteProjectManager.sidebar",
        "contents": "%viewsWelcome.sidebar.contents%"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "remoteProjectManager.provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab"
          ],
          "default": "github",
          "description": "%configuration.provider.description%"
        },
        "remoteProjectManager.repository": {
          "type": "string",
          "default": "",
          "description": "%configuration.repository.description%"
        },
        "remoteProjectManager.gitlabHost": {
          "type": "string",
          "default": "",
          "description": "%configuration.gitlabHost.description%"
        },
        "remoteProjectManager.cacheTtlSeconds": {
          "type": "number",
          "default": 180,
          "minimum": 0,
          "description": "%configuration.cacheTtlSeconds.description%"
        },
        "remoteProjectManager.autoBranchOnInProgress": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.autoBranchOnInProgress.description%"
        },
        "remoteProjectManager.branchNamePattern": {
          "type": "string",
          "default": "${type}/${issue_id}-${slug}",
          "description": "%configuration.branchNamePattern.description%"
        },
        "remoteProjectManager.aiContextFile": {
          "type": "string",
          "default": ".github/copilot-instructions.md",
          "description": "%configuration.aiContextFile.description%"
        },
        "remoteProjectManager.syncMarkInProgressOnCommit": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.syncMarkInProgressOnCommit.description%"
        },
        "remoteProjectManager.syncRemindMissingIssue": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.syncRemindMissingIssue.description%"
        },
        "remoteProjectManager.syncProposeCloseOnMerge": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.syncProposeCloseOnMerge.description%"
        },
        "remoteProjectManager.todoCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.todoCodeLens.description%"
        },
        "remoteProjectManager.autoRefreshSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "description": "%configuration.autoRefreshSeconds.description%"
        }
      }
    },
    "menus": {
      "view/item/context": [
        {
          "command": "remoteProjectManager.createBranchForIssue",
          "when": "view == remoteProjectManager.sidebar && viewItem == issue",
          "group": "inline@1"
        },
        {
          "command": "remoteProjectManager.copyIssueContext",
          "when": "view == remoteProjectManager.sidebar && viewItem == issue",
          "group": "inline@2"
        },
        {
          "command": "remoteProjectManager.createPrFromIssue",
          "when": "view == remoteProjectManager.sidebar && viewItem == issue",
          "group": "inline@3"
        },
        {
          "command": "remoteProjectManager.openIssueInBrowser",
          "when": "view == remoteProjectManager.sidebar && viewItem == issue",
          "group": "inline@4"
        },
        {
          "command": "remoteProjectManager.createBranchForIssue",
          "when": "view == remoteProjectManager.sidebar && viewItem == issue",
          "group": "1_git@1"
        },
        {
          "command": "remoteProjectManager.createPrFromIssue",
          "when": "view == remoteProjectManager.sidebar && viewItem == issue",
          "group": "1_git@2"
        },
        {
          "command": "remoteProjectManager.copyIssueContext",
          "when": "view == remoteProjectManager.sidebar && viewItem == issue",
          "group": "2_ai@1"
        },
        {
          "command": "remoteProjectManager.openIssueInBrowser",
          "when": "view == remoteProjectManager.sidebar && viewItem == issue",
          "group": "3_open@1"
        }
      ],
      "commandPalette": [
        {
          "command": "remoteProjectManager.createBranchForIssue",
          "when": "false"
        },
        {
          "command": "remoteProjectManager.openIssueInBrowser",
          "when": "false"
        },
        {
          "command": "remoteProjectManager.createIssueFromTodo",
          "when": "false"
        },
        {
          "command": "remoteProjectManager.openIssueByNumber",
          "when": "false"
        },
        {
          "command": "remoteProjectManager.createIssueFromSelection",
          "when": "editorHasSelection"
        }
      ],
      "scm/title": [
        {
          "command": "remoteProjectManager.composeCommit",
          "when": "scmProvider == git",
          "group": "navigation@10"
        }
      ],
      "editor/context": [
        {
          "command": "remoteProjectManager.createIssueFromSelection",
          "when": "editorHasSelection",
          "group": "9_remoteProjectManager@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "remoteProjectManager.composeCommit",
        "key": "ctrl+alt+r c",
        "mac": "cmd+alt+r c"
      },
      {
        "command": "remoteProjectManager.pickGitmoji",
        "key": "ctrl+alt+r g",
        "mac": "cmd+alt+r g"
      },
      {
        "command": "remoteProjectManager.newIssue",
        "key": "ctrl+alt+r n",
        "mac": "cmd+alt+r n"
      },
      {
        "command": "remoteProjectManager.refresh",
        "key": "ctrl+alt+r r",
        "mac": "cmd+alt+r r"
      }
    ],
    "walkthroughs": [
      {
        "id": "getStarted",
        "title": "%walkthrough.getStarted.title%",
        "description": "%walkthrough.getStarted.description%",
        "steps": [
          {
            "id": "connect",
            "title": "%walkthrough.step.connect.title%",
            "description": "%walkthrough.step.connect.description%",
            "media": {
              "markdown": "media/walkthrough/connect.md"
            },
            "completionEvents": [
              "onCommand:remoteProjectManager.openPanel"
            ]
          },
          {
            "id": "provider",
            "title": "%walkthrough.step.provider.title%",
            "description": "%walkthrough.step.provider.description%",
            "media": {
              "markdown": "media/walkthrough/provider.md"
            },
            "completionEvents": [
              "onSettingChanged:remoteProjectManager.provider",
              "onSettingChanged:remoteProjectManager.gitlabHost"
            ]
          },
          {
            "id": "issue",
            "title": "%walkthrough.step.issue.title%",
            "description": "%walkthrough.step.issue.description%",
            "media": {
              "markdown": "media/walkthrough/issue.md"
            },
            "completionEvents": [
              "onCommand:remoteProjectManager.newIssue"
            ]
          },
          {
            "id": "commit",
            "title": "%walkthrough.step.commit.title%",
            "description": "%walkthrough.step.commit.description%",
            "media": {
              "markdown": "media/walkthrough/commit.md"
            },
            "completionEvents": [
              "onCommand:remoteProjectManager.composeCommit"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p . && tsc -p tsconfig.webview.json",
    "watch": "tsc -w -p .",
    "watch:webview": "tsc -w -p tsconfig.webview.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=junit --reporter=default --outputFile=test-results/junit.xml",
    "test:integration": "npm run compile && node test-integration/runTests.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "npm run compile && vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/sinon": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "mocha": "^12.0.2",
    "prettier": "^3.9.9",
    "sinon": "^22.1.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@gitbeaker/rest": "^43.8.0",
    "@octokit/rest": "^22.0.1",
    "simple-git": "^3.36.0"
  },
  "l10n": "./l10n"
}
