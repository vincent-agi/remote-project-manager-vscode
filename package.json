{
  "name": "remote-project-manager",
  "displayName": "Remote Project Manager",
  "description": "View and manage GitHub and GitLab Issues and Milestones from a central panel in VS Code.",
  "version": "0.0.1",
  "publisher": "local-dev",
  "icon": "media/plugin-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/vincent-agi/vs-code-github-internal-project-managment.git"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "remoteProjectManager.openPanel",
        "title": "Remote Project Manager: Open Panel"
      },
      {
        "command": "remoteProjectManager.signOutGitLab",
        "title": "Remote Project Manager: Sign Out of GitLab"
      },
      {
        "command": "remoteProjectManager.newIssue",
        "title": "Remote Project Manager: New Issue"
      },
      {
        "command": "remoteProjectManager.newMilestone",
        "title": "Remote Project Manager: New Milestone"
      },
      {
        "command": "remoteProjectManager.refresh",
        "title": "Remote Project Manager: Refresh"
      },
      {
        "command": "remoteProjectManager.composeCommit",
        "title": "Remote Project Manager: Compose Commit (Conventional + Gitmoji)",
        "icon": "$(sparkle)"
      },
      {
        "command": "remoteProjectManager.pickGitmoji",
        "title": "Remote Project Manager: Pick Gitmoji"
      },
      {
        "command": "remoteProjectManager.copyIssueContext",
        "title": "Remote Project Manager: Copy Issue Context for AI",
        "icon": "$(copy)"
      },
      {
        "command": "remoteProjectManager.createPrFromIssue",
        "title": "Remote Project Manager: Create PR from Issue",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "remoteProjectManager.showGitGraph",
        "title": "Remote Project Manager: Show Git Graph (by Issue)"
      },
      {
        "command": "remoteProjectManager.lintCommitHistory",
        "title": "Remote Project Manager: Lint Commit History"
      },
      {
        "command": "remoteProjectManager.exportMilestoneContext",
        "title": "Remote Project Manager: Export Milestone Context for AI Agents"
      },
      {
        "command": "remoteProjectManager.createBranchForIssue",
        "title": "Remote Project Manager: Create Branch for Issue",
        "icon": "$(git-branch)"
      },
      {
        "command": "remoteProjectManager.openIssueInBrowser",
        "title": "Remote Project Manager: Open Issue in Browser",
        "icon": "$(link-external)"
      },
      {
        "command": "remoteProjectManager.runDiagnostics",
        "title": "Remote Project Manager: Run Diagnostics"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "remoteProjectManager",
          "title": "Remote Project Manager",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "remoteProjectManager": [
        {
          "id": "remoteProjectManager.sidebar",
          "name": "Remote Project Manager"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "remoteProjectManager.sidebar",
        "contents": "Manage GitHub and GitLab Issues and Milestones from a central panel.\n[Open Panel](command:remoteProjectManager.openPanel)"
      }
    ],
    "configuration": {
      "title": "Remote Project Manager",
      "properties": {
        "remoteProjectManager.provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab"
          ],
          "default": "github",
          "description": "Remote platform to connect to."
        },
        "remoteProjectManager.repository": {
          "type": "string",
          "default": "",
          "description": "Fallback repository or project path, e.g. 'owner/repo'. Only used when no workspace folder has a recognized git 'origin' remote; the detected remote always wins."
        },
        "remoteProjectManager.gitlabHost": {
          "type": "string",
          "default": "",
          "description": "Hostname of a self-hosted GitLab instance (e.g. 'gitlab.example.com'), used both to auto-detect repositories on that host and to connect to its API. Leave empty to use gitlab.com."
        },
        "remoteProjectManager.cacheTtlSeconds": {
          "type": "number",
          "default": 180,
          "minimum": 0,
          "description": "How long issue/milestone/capability reads are cached before refetching, in seconds. Use the panel's Refresh button to bypass the cache immediately."
        },
        "remoteProjectManager.autoBranchOnInProgress": {
          "type": "boolean",
          "default": true,
          "description": "Automatically create and check out a git branch when an issue assigned to you moves to 'in-progress'. When off, a suggested branch name is shown instead."
        },
        "remoteProjectManager.branchNamePattern": {
          "type": "string",
          "default": "${type}/${issue_id}-${slug}",
          "description": "Pattern for auto-created branch names. Placeholders: ${type} (inferred from labels, e.g. fix/feature/docs/issue), ${issue_id} (issue number), ${slug} (sanitized title)."
        },
        "remoteProjectManager.aiContextFile": {
          "type": "string",
          "default": ".github/copilot-instructions.md",
          "description": "Workspace-relative path 'Export Milestone Context for AI Agents' writes to. Only the extension-managed section (between HTML comment markers) is replaced on re-export; the rest of the file, if any, is left untouched."
        }
      }
    },
    "menus": {
      "view/item/context": [
        {
          "command": "remoteProjectManager.createBranchForIssue",
          "when": "view == remoteProjectManager.sidebar && viewItem == issue",
          "group": "inline@1"
        },
        {
          "command": "remoteProjectManager.copyIssueContext",
          "when": "view == remoteProjectManager.sidebar && viewItem == issue",
          "group": "inline@2"
        },
        {
          "command": "remoteProjectManager.createPrFromIssue",
          "when": "view == remoteProjectManager.sidebar && viewItem == issue",
          "group": "inline@3"
        },
        {
          "command": "remoteProjectManager.openIssueInBrowser",
          "when": "view == remoteProjectManager.sidebar && viewItem == issue",
          "group": "inline@4"
        },
        {
          "command": "remoteProjectManager.createBranchForIssue",
          "when": "view == remoteProjectManager.sidebar && viewItem == issue",
          "group": "1_git@1"
        },
        {
          "command": "remoteProjectManager.createPrFromIssue",
          "when": "view == remoteProjectManager.sidebar && viewItem == issue",
          "group": "1_git@2"
        },
        {
          "command": "remoteProjectManager.copyIssueContext",
          "when": "view == remoteProjectManager.sidebar && viewItem == issue",
          "group": "2_ai@1"
        },
        {
          "command": "remoteProjectManager.openIssueInBrowser",
          "when": "view == remoteProjectManager.sidebar && viewItem == issue",
          "group": "3_open@1"
        }
      ],
      "commandPalette": [
        {
          "command": "remoteProjectManager.createBranchForIssue",
          "when": "false"
        },
        {
          "command": "remoteProjectManager.openIssueInBrowser",
          "when": "false"
        }
      ],
      "scm/title": [
        {
          "command": "remoteProjectManager.composeCommit",
          "when": "scmProvider == git",
          "group": "navigation@10"
        }
      ]
    },
    "keybindings": [
      {
        "command": "remoteProjectManager.composeCommit",
        "key": "ctrl+alt+r c",
        "mac": "cmd+alt+r c"
      },
      {
        "command": "remoteProjectManager.pickGitmoji",
        "key": "ctrl+alt+r g",
        "mac": "cmd+alt+r g"
      },
      {
        "command": "remoteProjectManager.newIssue",
        "key": "ctrl+alt+r n",
        "mac": "cmd+alt+r n"
      },
      {
        "command": "remoteProjectManager.refresh",
        "key": "ctrl+alt+r r",
        "mac": "cmd+alt+r r"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p . && tsc -p tsconfig.webview.json",
    "watch": "tsc -w -p .",
    "watch:webview": "tsc -w -p tsconfig.webview.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=junit --reporter=default --outputFile=test-results/junit.xml",
    "test:integration": "npm run compile && node test-integration/runTests.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "npm run compile && vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/sinon": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "mocha": "^12.0.2",
    "prettier": "^3.9.9",
    "sinon": "^22.1.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@gitbeaker/rest": "^43.8.0",
    "@octokit/rest": "^22.0.1",
    "simple-git": "^3.36.0"
  }
}
